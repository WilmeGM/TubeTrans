@{
    var appVersion = typeof(TubeTrans.Program).Assembly.GetName().Version!.ToString(3);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Youtube Translator | TubeTrans @ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TubeTrans.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
</head>
<body class="app-shell">
    <header class="border-bottom">
        <div class="container py-3">
            <a class="d-inline-flex align-items-center gap-2 text-decoration-none"
               asp-area="" asp-controller="Transcript" asp-action="Index">
                <span class="text-danger d-inline-flex">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M10.804 8 5 4.633v6.734L10.804 8zm.792-.696a.802.802 0 0 1 0 1.392l-6.363 3.692C4.713 12.69 4 12.345 4 11.692V4.308c0-.653.713-.998 1.233-.696z" />
                    </svg>
                </span>
                <span class="fs-4 fw-bold text-dark">TubeTrans</span>
            </a>
        </div>
    </header>

    <div class="app-main">
        <div class="container h-100">
            <main role="main" class="h-100">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top text-muted">
        <div class="container py-3 small d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>
                &copy; 2026 - TubeTrans v.@appVersion &middot;
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-danger text-decoration-none">Privacy</a>
            </span>
            <a href="https://github.com/WilmeGM" target="_blank" rel="noopener"
               class="d-inline-flex align-items-center gap-1 text-muted text-decoration-none">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                    0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
                    -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
                    .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
                    -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0
                    1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82
                    1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01
                    1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                </svg>
                Wilme González
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>