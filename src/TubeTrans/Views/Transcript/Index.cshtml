@model Application.ViewModels.TranscriptRequestViewModel
@{
    var response = ViewBag.Response as Application.ViewModels.TranscriptResponseViewModel;
    bool showTranscript = response is not null && !response.HasError;
}

<div class="@(showTranscript ? "py-4" : "d-flex align-items-center justify-content-center h-100")">

    <div class="row justify-content-center text-center w-100">
        <div class="col-12 col-lg-7">

            @if (response is not null && response.HasError)
            {
                <div class="d-inline-flex align-items-center gap-2 border rounded-pill px-3 py-2 mb-4 small border-danger text-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16M8 4a.905.905 0 0 1 .9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995A.905.905 0 0 1 8 4m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
                    </svg>
                    @response.ErrorMessage
                </div>
            }

            <h1 class="fw-bold mb-2 @(showTranscript ? "fs-3" : "")">
                Get any <span class="text-danger">YouTube</span> transcript
            </h1>
            <p class="text-muted mb-4">
                Paste a public video link and read its transcript in seconds.
            </p>

            <form method="post" asp-controller="Transcript" asp-action="Index">
                <div class="input-group input-group-lg shadow-sm">
                    <input asp-for="Url" type="url" class="form-control rounded-start-pill ps-4"
                           placeholder="https://www.youtube.com/watch?v=..."
                           autocomplete="off" required />
                    <button type="submit" class="btn btn-danger rounded-end-pill px-4">
                        Get transcript
                    </button>
                </div>
                <span asp-validation-for="Url" class="d-block text-danger small mt-2 text-start"></span>
            </form>

        </div>
    </div>

    @if (showTranscript)
    {
        <div class="d-flex justify-content-between align-items-end mb-2">
            <div>
                <h2 class="text-uppercase text-muted small fw-bold mb-1">Transcript</h2>
                <p class="fw-semibold mb-0">@response!.VideoTitle</p>
            </div>
            <button type="button" id="copyBtn" class="btn btn-outline-danger btn-sm rounded-pill flex-shrink-0">
                Copy
            </button>
        </div>

        <textarea id="transcriptText" class="form-control" rows="14" readonly>@response.Text</textarea>
    }

</div>

@section Scripts {
    <script>
        (function() {
            const btn = document.getElementById('copyBtn');
            const textarea = document.getElementById('transcriptText');
            if (!btn || !textarea) return;

            btn.addEventListener('click', function() {
                navigator.clipboard.writeText(textarea.value).then(function() {
                    const originalLabel = btn.textContent;
                    btn.textContent = 'Copied!';
                    setTimeout(function() { btn.textContent = originalLabel; }, 1500);
                });
            });
        })();
    </script>
}